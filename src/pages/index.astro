---
import App from '../App';
import '../index.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Lunar Light Awakening is a wellness and crystal shop in Schofield, WI offering stones, jewelry, herbal products, workshops, and practitioner services."
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Lunar Light Awakening | Wellness, Stones & Sacred Space</title>
    <link rel="canonical" href="https://lunarlightawakening.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lunar Light Awakening" />
    <meta property="og:title" content="Lunar Light Awakening | Wellness, Stones & Sacred Space" />
    <meta property="og:description" content="Wellness and crystal shop in Schofield, WI offering stones, jewelry, herbal products, workshops, and practitioner services." />
    <meta property="og:url" content="https://lunarlightawakening.com/" />
    <meta property="og:image" content="https://lunarlightawakening.com/logo.png" />
    <meta property="og:image:alt" content="Lunar Light Awakening logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Lunar Light Awakening | Wellness, Stones & Sacred Space" />
    <meta name="twitter:description" content="Wellness and crystal shop in Schofield, WI offering stones, jewelry, herbal products, workshops, and practitioner services." />
    <meta name="twitter:image" content="https://lunarlightawakening.com/logo.png" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Store",
        "@id": "https://lunarlightawakening.com/#store",
        "name": "Lunar Light Awakening",
        "url": "https://lunarlightawakening.com/",
        "telephone": "715-581-7317",
        "email": "lunarlightawakening@gmail.com",
        "image": "https://lunarlightawakening.com/logo.png",
        "sameAs": ["https://www.facebook.com/lunarlightawakening"],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "121 Skelly Street",
          "addressLocality": "Schofield",
          "addressRegion": "WI",
          "postalCode": "54476",
          "addressCountry": "US"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "opens": "10:00",
            "closes": "18:00"
          }
        ],
        "description": "Wellness and crystal shop in Schofield, WI offering stones, jewelry, herbal products, workshops, and practitioner services including Reiki, sound healing, and crystal therapy."
      }
    </script>
  </head>
  <body>
    <App client:load />
  </body>
</html>
