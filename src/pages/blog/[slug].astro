---
import '../../index.css';
import { blogPosts, getBlogPostBySlug } from '../../data/blogPosts';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const post = Astro.props.post ?? getBlogPostBySlug(slug ?? '');

if (!post) {
  return Astro.redirect('/blog/');
}

const pageTitle = `${post.title} | Lunar Light Awakening`;
const pageDescription = post.excerpt;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-celestial-dark text-white font-sans selection:bg-gold selection:text-celestial-dark">
    <header class="border-b border-white/10 bg-celestial-dark/95">
      <nav class="container mx-auto flex items-center justify-between px-6 py-5">
        <a href="/" class="flex items-center gap-3 text-gold-light">
          <img src="/logo.png" alt="Lunar Light Awakening" class="h-10 w-10 object-contain" />
          <span class="font-display text-lg tracking-[0.2em]">LUNAR LIGHT</span>
        </a>
        <a href="/blog/" class="text-xs uppercase tracking-[0.3em] text-white/60 transition-colors hover:text-gold">
          All Posts
        </a>
      </nav>
    </header>

    <main>
      <article>
        <section class="relative overflow-hidden">
          <div class="absolute inset-0">
            <img src={post.image} alt="" class="h-full w-full object-cover opacity-35" referrerpolicy="no-referrer" />
            <div class="absolute inset-0 bg-gradient-to-b from-celestial-dark/70 via-celestial-dark/85 to-celestial-dark"></div>
          </div>
          <div class="container relative mx-auto px-6 py-24 text-center md:py-32">
            <p class="mb-5 text-xs uppercase tracking-[0.35em] text-gold">{post.category}</p>
            <h1 class="mx-auto max-w-5xl font-display text-4xl leading-tight text-gold-light md:text-6xl">
              {post.title}
            </h1>
            <div class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs uppercase tracking-[0.22em] text-white/55">
              <span>{post.author}</span>
              <time>{post.date}</time>
              <span>{post.readTime}</span>
            </div>
          </div>
        </section>

        <section class="bg-white py-16 text-celestial-dark md:py-24">
          <div class="container mx-auto px-6">
            <div class="mx-auto max-w-3xl">
              <p class="mb-10 border-l-2 border-gold pl-6 font-serif text-2xl italic leading-relaxed text-gray-700">
                {post.excerpt}
              </p>

              <div class="space-y-12">
                {
                  post.sections.map((section) => (
                    <section>
                      {section.heading && (
                        <h2 class="mb-5 font-display text-2xl leading-tight text-gold md:text-3xl">{section.heading}</h2>
                      )}
                      {section.paragraphs?.map((paragraph) => (
                        <p class="mb-5 font-serif text-xl leading-relaxed text-gray-700">{paragraph}</p>
                      ))}
                      {section.list && (
                        <ul class="space-y-4">
                          {section.list.map((item) => (
                            <li class="border-l border-gold/40 pl-5 font-serif text-xl leading-relaxed text-gray-700">
                              {item}
                            </li>
                          ))}
                        </ul>
                      )}
                    </section>
                  ))
                }
              </div>

              <div class="mt-16 flex flex-col gap-4 border-t border-gray-100 pt-8 sm:flex-row sm:items-center sm:justify-between">
                <a
                  href="/blog/"
                  class="inline-flex text-xs font-bold uppercase tracking-[0.25em] text-gold transition-colors hover:text-celestial-dark"
                >
                  Back to Blog
                </a>
                <a
                  href="/#contact"
                  class="inline-flex text-xs font-bold uppercase tracking-[0.25em] text-celestial-dark/55 transition-colors hover:text-gold"
                >
                  Visit the Shop
                </a>
              </div>
            </div>
          </div>
        </section>
      </article>
    </main>

    <footer class="border-t border-white/10 bg-celestial-dark px-6 py-10 text-center">
      <p class="text-xs uppercase tracking-[0.25em] text-white/35">
        Copyright {new Date().getFullYear()} Lunar Light Awakening. All Rights Reserved.
      </p>
    </footer>
  </body>
</html>
